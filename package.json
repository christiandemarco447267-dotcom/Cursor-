{
  "name": "sentia",
  "version": "1.2.0",
  "private": true,
  "description": "Sentia \u2014 a focused, professional paper-trading coach (buy/sell simulation, portfolio, theses, insights) with local-first data.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:firebase": "node scripts/build-static.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:mobile": "node scripts/build-static.mjs --target=native && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "assets:generate": "bash scripts/generate-app-assets.sh",
    "deploy:firebase": "firebase deploy --only hosting,firestore:rules",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/**/*.test.ts",
    "og:image": "tsx scripts/generate-og-image.tsx",
    "data:time-machine": "node scripts/fetch-time-machine-data.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "lucide-react": "^1.25.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "@grpc/grpc-js": "^1.14.6"
  }
}
