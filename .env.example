# Market data is optional. Without any key, the app shows a live, auto-updating
# simulated feed (prices move every ~15s and the UI reflects them automatically).

# Realtime quotes for a SERVER deployment (npm run start / Vercel / Node).
# Kept server-side only — never exposed to the browser.
FINNHUB_API_KEY=

# Realtime quotes for a STATIC / browser deployment (e.g. GitHub Pages).
# This value is bundled into the client, so only use a key you're OK exposing.
NEXT_PUBLIC_FINNHUB_API_KEY=

# ---- Accounts (Firebase Auth + Firestore) ----------------------------------
# Optional. When these are unset the app runs guest-only (local demo), as before.
# Find them in Firebase console → Project settings → General → Your apps → Web app.
# They're bundled into the client by design (not secrets); data access is enforced
# by Firebase Auth + firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
