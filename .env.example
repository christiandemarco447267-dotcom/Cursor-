# Market data is optional. Without any key, the app shows a live, auto-updating
# simulated feed (prices move every ~15s and the UI reflects them automatically).

# Realtime quotes for a SERVER deployment (npm run start / Vercel / Node).
# Kept server-side only — never exposed to the browser.
FINNHUB_API_KEY=

# Real quotes, feedback, usage counts and the AI coach for ANY deployment
# (including static GitHub Pages): the URL of the Sentia API Worker in /worker.
# It's a public URL, not a secret. All API keys stay inside the Worker.
# See PILOT_SETUP.md. Leave empty for demo prices + built-in coach.
NEXT_PUBLIC_SENTIA_API_URL=
# Optional public email for the no-API feedback fallback (mailto link).
NEXT_PUBLIC_FEEDBACK_EMAIL=

# ---- Accounts (Firebase Auth + Firestore) ----------------------------------
# Optional. When these are unset the app runs guest-only (local demo), as before.
# Find them in Firebase console → Project settings → General → Your apps → Web app.
# They're bundled into the client by design (not secrets); data access is enforced
# by Firebase Auth + firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
